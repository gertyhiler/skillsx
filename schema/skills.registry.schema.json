{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skillsx registry v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "categories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "git"
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "url"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "copy"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\u0000]+$"
              }
            },
            "required": [
              "type",
              "path"
            ]
          }
        ]
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.[a-z0-9-]+/skills$"
          },
          "transport": {
            "enum": [
              "direct",
              "symlink",
              "copy"
            ]
          }
        },
        "required": []
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "categoryId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\u0000]+$"
              },
              "revision": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64}|sha256:[a-f0-9]{64})$"
              }
            },
            "required": [
              "id",
              "path",
              "revision"
            ]
          },
          "hashes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "payload": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "metadata": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "payload",
              "metadata"
            ]
          },
          "refines": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reviewedRevision": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "reviewedRevision"
              ]
            }
          }
        },
        "required": [
          "hashes"
        ]
      }
    }
  },
  "required": [
    "version",
    "categories",
    "sources",
    "agents",
    "skills"
  ]
}
